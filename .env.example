# PostgreSQL connection (local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_db
# Set true only when your PostgreSQL provider requires SSL
DATABASE_SSL=false

# API server
PORT=5000
JWT_SECRET=replace_with_a_private_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional database/test configuration
USE_PG_MEM=false
DATABASE_URL_TEST=

# Vite client; /api is proxied to the local API by vite.config.js
VITE_API_BASE_URL=/api
